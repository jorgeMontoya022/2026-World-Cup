                <TableView fx:id="tablaGrupoA" fixedCellSize="36" maxWidth="Infinity" prefHeight="180" styleClass="group-table">
                    <columns>
                        <TableColumn fx:id="colPosA" maxWidth="30" minWidth="30" text="#" />
                        <TableColumn fx:id="colEquipoA" minWidth="100" text="Equipo" />
                        <TableColumn fx:id="colPtsA" maxWidth="50" minWidth="40" text="Pts" />
                    </columns>
                    <placeholder><Label text="" /></placeholder>
                </TableView>
            </VBox>

