<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox maxHeight="Infinity" maxWidth="Infinity" spacing="16" styleClass="page-container" stylesheets="@../css/styles.css" VBox.vgrow="ALWAYS" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uniquindio.cup.world_app.controller.UsuariosController">

    <padding><Insets bottom="24" left="28" right="28" top="24" /></padding>

    <!-- ══ Encabezado ══ -->
    <HBox alignment="CENTER_LEFT" maxWidth="Infinity" spacing="16">
        <VBox spacing="4" HBox.hgrow="ALWAYS">
            <Label styleClass="page-title" text="GESTION DE USUARIOS" />
            <Label styleClass="page-subtitle" text="Solo el Administrador puede crear y gestionar usuarios" />
        </VBox>
        <Button onAction="#abrirFormularioNuevo" styleClass="btn-primary-sm" text="+ Crear Usuario" />
    </HBox>

    <!-- ══ Alerta informativa ══ -->
    <Label maxWidth="Infinity" styleClass="alert-warning" text="Solo el usuario Administrador puede crear, editar o eliminar usuarios del sistema." wrapText="true" />

    <!-- ══ Filtro por nombre de usuario ══ -->
    <HBox alignment="CENTER_LEFT" maxWidth="Infinity" spacing="10">
        <TextField fx:id="txfBuscar" maxWidth="Infinity" onKeyReleased="#filtrarTabla" promptText="Buscar por nombre de usuario..." styleClass="input-field" HBox.hgrow="ALWAYS" />

        <ComboBox fx:id="cmbTipo" onAction="#filtrarTabla" prefWidth="180" promptText="Tipo de usuario" styleClass="combo-field" />
    </HBox>

    <!-- ══ Tabla de usuarios ══ -->
    <TableView fx:id="tablaUsuarios" maxHeight="Infinity" maxWidth="Infinity" styleClass="data-table" VBox.vgrow="ALWAYS">

        <columns>
            <TableColumn fx:id="colUsuario" minWidth="120" text="Usuario" />
            <TableColumn fx:id="colNombre" minWidth="180" text="Nombre completo" />
            <TableColumn fx:id="colTipo" minWidth="130" text="Tipo" />
            <TableColumn fx:id="colEstado" minWidth="100" text="Estado" />
            <TableColumn fx:id="colUltimoAcceso" minWidth="160" text="Ultimo acceso" />
            <TableColumn fx:id="colAcciones" minWidth="110" text="Acciones" />
        </columns>

        <placeholder>
            <Label styleClass="table-placeholder" text="No se encontraron usuarios" />
        </placeholder>

    </TableView>

    <!-- ══ Tabla de permisos ══ -->
    <VBox spacing="0" styleClass="group-card">
        <Label maxWidth="Infinity" styleClass="group-header" text="Permisos por tipo de usuario" />

        <TableView fx:id="tablaPermisos" fixedCellSize="36" maxWidth="Infinity" prefHeight="190" styleClass="group-table">
            <columns>
                <TableColumn fx:id="colPermiso" minWidth="220" prefWidth="240.00001462300617" text="Permiso" />
                <TableColumn fx:id="colAdmin" minWidth="120" prefWidth="170.6666717529297" text="Administrador" />
                <TableColumn fx:id="colTradicional" minWidth="120" prefWidth="165.33334350585938" text="Tradicional" />
                <TableColumn fx:id="colEsporadico" minWidth="120" prefWidth="225.99993896484375" text="Esporadico" />
            </columns>
            <placeholder><Label text="" /></placeholder>
        </TableView>
    </VBox>

    <!-- ══ Paginación ══ -->
    <HBox alignment="CENTER_RIGHT" spacing="10">
        <Label fx:id="lblPaginacion" styleClass="pagination-info" text="Mostrando 1-10 de 0 usuarios" />
        <Button fx:id="btnAnterior" disable="true" onAction="#paginaAnterior" styleClass="btn-ghost-sm" text="Anterior" />
        <Button fx:id="btnSiguiente" onAction="#paginaSiguiente" styleClass="btn-ghost-sm" text="Siguiente" />
    </HBox>

</VBox>
