<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox maxHeight="Infinity" maxWidth="Infinity" spacing="16" styleClass="page-container" stylesheets="@../css/styles.css" VBox.vgrow="ALWAYS" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uniquindio.cup.world_app.controller.UsuariosController">

    <padding><Insets bottom="24" left="28" right="28" top="24" /></padding>

    <!-- ══ Encabezado ══ -->
    <HBox alignment="CENTER_LEFT" maxWidth="Infinity" spacing="16">
        <VBox spacing="4" HBox.hgrow="ALWAYS">
            <Label styleClass="page-title" text="GESTION DE USUARIOS" />
            <Label styleClass="page-subtitle" text="Solo el Administrador puede crear y gestionar usuarios" />
        </VBox>
        <Button onAction="#abrirFormularioNuevo" styleClass="btn-primary-sm" text="+ Crear Usuario" />
    </HBox>

    <!-- ══ Alerta informativa ══ -->
    <Label maxWidth="Infinity" styleClass="alert-warning" text="Solo el usuario Administrador puede crear, editar o eliminar usuarios del sistema." wrapText="true" />

    <!-- ══ Filtro por nombre de usuario ══ -->
    <HBox alignment="CENTER_LEFT" maxWidth="Infinity" spacing="10">
        <TextField fx:id="txfBuscar" maxWidth="Infinity" onKeyReleased="#filtrarTabla" promptText="Buscar por nombre de usuario..." styleClass="input-field" HBox.hgrow="ALWAYS" />

        <ComboBox fx:id="cmbTipo" onAction="#filtrarTabla" prefWidth="180" promptText="Tipo de usuario" styleClass="combo-field" />
    </HBox>

    <!-- ══ Tabla de usuarios ══ -->
    <TableView fx:id="tablaUsuarios" maxHeight="Infinity" maxWidth="Infinity"
               styleClass="data-table"
               VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colUsuario"      prefWidth="130" text="Usuario" />
            <TableColumn fx:id="colNombre"       prefWidth="200" text="Nombre completo" />
            <TableColumn fx:id="colTipo"         prefWidth="140" text="Tipo" />
            <TableColumn fx:id="colEstado"       prefWidth="100" text="Estado" />
            <TableColumn fx:id="colUltimoAcceso" prefWidth="170" text="Ultimo acceso" />
            <TableColumn fx:id="colAcciones"     prefWidth="120" text="Acciones" />
        </columns>

        <placeholder>
            <Label styleClass="table-placeholder" text="No se encontraron usuarios" />
        </placeholder>

    </TableView>

    <!-- ══ Paginación ══ -->
    <HBox alignment="CENTER_RIGHT" spacing="10">
        <Label fx:id="lblPaginacion" styleClass="pagination-info" text="Mostrando 1-10 de 0 usuarios" />
        <Button fx:id="btnAnterior" disable="true" onAction="#paginaAnterior" styleClass="btn-ghost-sm" text="Anterior" />
        <Button fx:id="btnSiguiente" onAction="#paginaSiguiente" styleClass="btn-ghost-sm" text="Siguiente" />
    </HBox>

    <!-- ══ Tabla de permisos por rol ══ -->
    <Label styleClass="section-title" text="Permisos por tipo de usuario" />
    <TableView fx:id="tablaPermisos" maxHeight="200" maxWidth="Infinity" styleClass="data-table">
        <columns>
            <TableColumn fx:id="colPermiso" minWidth="200" text="Permiso" />
            <TableColumn fx:id="colAdmin" minWidth="100" text="Administrador" />
            <TableColumn fx:id="colTradicional" minWidth="100" text="Tradicional" />
            <TableColumn fx:id="colEsporadico" minWidth="100" text="Esporádico" />
        </columns>
        <placeholder>
            <Label styleClass="table-placeholder" text="Sin datos" />
        </placeholder>
    </TableView>

</VBox>
