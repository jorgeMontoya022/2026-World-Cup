<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="co.edu.uniquindio.cup.world_app.controller.MainController"
            fx:id="rootPane"
            styleClass="root-pane"
            stylesheets="@../css/styles.css">

    <!-- ══ SIDEBAR ══ -->
    <left>
        <VBox styleClass="sidebar" spacing="0">

            <!-- Logo -->
            <VBox styleClass="sidebar-header" spacing="2">
                <Label text="⚽ MUNDIAL 2026" styleClass="sidebar-title" />
                <Label text="Sistema de Gestión" styleClass="sidebar-subtitle" />
            </VBox>

            <!-- Info usuario -->
            <HBox styleClass="user-info-bar" spacing="10" alignment="CENTER_LEFT">
                <Label fx:id="lblUserAvatar" styleClass="user-avatar" text="A" />
                <VBox spacing="2">
                    <Label fx:id="lblUserName" styleClass="user-name" text="Usuario" />
                    <Label fx:id="lblUserRole" styleClass="user-role" text="Rol" />
                </VBox>
            </HBox>

            <Separator styleClass="nav-separator" />

            <!-- Navegación -->
            <ScrollPane styleClass="nav-scroll" fitToWidth="true" VBox.vgrow="ALWAYS">
                <VBox styleClass="nav-container" spacing="0">

                    <Label text="GESTIÓN" styleClass="nav-section-label" />
                    <Button fx:id="btnDashboard"  text="🏠  Dashboard"       styleClass="nav-item" maxWidth="Infinity" onAction="#irDashboard"   />
                    <Button fx:id="btnEquipos"    text="🌍  Equipos"         styleClass="nav-item" maxWidth="Infinity" onAction="#irEquipos"    />
                    <Button fx:id="btnJugadores"  text="⚽  Jugadores"       styleClass="nav-item" maxWidth="Infinity" onAction="#irJugadores"  />
                    <Button fx:id="btnTecnicos"   text="🧑‍💼  Técnicos"        styleClass="nav-item" maxWidth="Infinity" onAction="#irTecnicos"   />
                    <Button fx:id="btnEstadios"   text="🏟️  Estadios"        styleClass="nav-item" maxWidth="Infinity" onAction="#irEstadios"   />

                    <Label text="TORNEO" styleClass="nav-section-label" />
                    <Button fx:id="btnGrupos"     text="📋  Grupos"          styleClass="nav-item" maxWidth="Infinity" onAction="#irGrupos"     />
                    <Button fx:id="btnPartidos"   text="🎯  Partidos"        styleClass="nav-item" maxWidth="Infinity" onAction="#irPartidos"   />

                    <Label text="ANÁLISIS" styleClass="nav-section-label" />
                    <Button fx:id="btnConsultas"  text="🔍  Consultas"       styleClass="nav-item" maxWidth="Infinity" onAction="#irConsultas"  />
                    <Button fx:id="btnReportes"   text="📄  Reportes PDF"    styleClass="nav-item" maxWidth="Infinity" onAction="#irReportes"   />

                    <Label text="ADMINISTRACIÓN" styleClass="nav-section-label" />
                    <Button fx:id="btnUsuarios" text="👥  Usuarios"  styleClass="nav-item" maxWidth="Infinity" onAction="#irUsuarios"  />
                    <Button fx:id="btnBitacora" text="📒  Bitácora"  styleClass="nav-item" maxWidth="Infinity" onAction="#irBitacora"  />

                </VBox>
            </ScrollPane>

            <!-- Footer: cerrar sesión -->
            <VBox styleClass="sidebar-footer">
                <Button text="⏻  Cerrar Sesión" styleClass="btn-logout" maxWidth="Infinity" onAction="#cerrarSesion" />
            </VBox>

        </VBox>
    </left>

    <!-- ══ ÁREA DE CONTENIDO ══ -->
    <center>
        <StackPane fx:id="contentArea" styleClass="content-area" />
    </center>

</BorderPane>
