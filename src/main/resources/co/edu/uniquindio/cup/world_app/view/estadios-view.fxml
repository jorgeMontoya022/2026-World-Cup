<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="co.edu.uniquindio.cup.world_app.controller.EstadiosController"
      styleClass="page-container"
      stylesheets="@../css/styles.css"
      spacing="16"
      maxWidth="Infinity"
      maxHeight="Infinity"
      VBox.vgrow="ALWAYS">

    <padding><Insets top="24" right="28" bottom="24" left="28"/></padding>

    <!-- ══ Encabezado ══ -->
    <HBox alignment="CENTER_LEFT" spacing="16" maxWidth="Infinity">
        <VBox HBox.hgrow="ALWAYS" spacing="4">
            <Label text="🏟️  ESTADIOS SEDE" styleClass="page-title" />
            <Label text="16 estadios en 3 paises anfitriones"
                   styleClass="page-subtitle" />
        </VBox>
        <Button fx:id="btnNuevo" text="+ Nuevo Estadio"
                styleClass="btn-primary-sm"
                onAction="#abrirFormularioNuevo" />
    </HBox>

    <!-- ══ Filtros ══ -->
    <HBox spacing="10" alignment="CENTER_LEFT" maxWidth="Infinity">
        <TextField fx:id="txfBuscar"
                   promptText="Buscar por nombre de estadio..."
                   styleClass="input-field"
                   HBox.hgrow="ALWAYS"
                   maxWidth="Infinity"
                   onKeyReleased="#filtrarTabla" />

        <ComboBox fx:id="cmbPais"
                  promptText="Pais anfitrion"
                  styleClass="combo-field"
                  onAction="#filtrarTabla"
                  prefWidth="170" />
    </HBox>

    <!-- ══ Tabla ══ -->
    <TableView fx:id="tablaEstadios"
               styleClass="data-table"
               VBox.vgrow="ALWAYS"
               maxWidth="Infinity"
               maxHeight="Infinity">

        <columns>
            <TableColumn fx:id="colNombre"    text="Nombre del estadio" prefWidth="220" />
            <TableColumn fx:id="colCiudad"    text="Ciudad"             prefWidth="150" />
            <TableColumn fx:id="colPais"      text="Pais anfitrion"     prefWidth="150" />
            <TableColumn fx:id="colCapacidad" text="Capacidad"          prefWidth="110" />
            <TableColumn fx:id="colPartidos"  text="Partidos asignados" prefWidth="150" />
            <TableColumn fx:id="colAcciones"  text="Acciones"           prefWidth="120" />
        </columns>

        <placeholder>
            <Label text="No se encontraron estadios" styleClass="table-placeholder" />
        </placeholder>

    </TableView>

    <!-- ══ Paginación ══ -->
    <HBox alignment="CENTER_RIGHT" spacing="10">
        <Label fx:id="lblPaginacion"
               text="Mostrando 1-10 de 16 estadios"
               styleClass="pagination-info" />
        <Button fx:id="btnAnterior"
                text="Anterior"
                styleClass="btn-ghost-sm"
                onAction="#paginaAnterior"
                disable="true" />
        <Button fx:id="btnSiguiente"
                text="Siguiente"
                styleClass="btn-ghost-sm"
                onAction="#paginaSiguiente" />
    </HBox>

</VBox>