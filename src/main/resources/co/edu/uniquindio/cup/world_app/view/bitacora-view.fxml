<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox maxHeight="Infinity" maxWidth="Infinity" spacing="16" styleClass="page-container" stylesheets="@../css/styles.css" VBox.vgrow="ALWAYS" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uniquindio.cup.world_app.controller.BitacoraController">

    <padding><Insets bottom="24" left="28" right="28" top="24" /></padding>

    <!-- ══ Encabezado ══ -->
    <HBox alignment="CENTER_LEFT" maxWidth="Infinity" spacing="16">
        <VBox spacing="4" HBox.hgrow="ALWAYS">
            <Label styleClass="page-title" text="BITACORA DEL SISTEMA" />
            <Label styleClass="page-subtitle" text="Registro de ingresos y salidas de usuarios — Solo Administrador" />
        </VBox>
    </HBox>

    <!-- ══ Filtros por rango de fechas ══ -->
    <HBox alignment="CENTER_LEFT" maxWidth="Infinity" spacing="10" styleClass="filter-bar">

        <Label styleClass="field-label" text="Desde:" />
        <DatePicker fx:id="dpDesde" prefWidth="160" promptText="Fecha inicio" styleClass="date-field" />

        <Label styleClass="field-label" text="Hasta:" />
        <DatePicker fx:id="dpHasta" prefWidth="160" promptText="Fecha fin" styleClass="date-field" />

        <Button onAction="#filtrarPorFecha" styleClass="btn-primary-sm" text="Filtrar" />

        <Button onAction="#limpiarFiltros" styleClass="btn-ghost-sm" text="Limpiar" />

        <!-- Empuja el contador hacia la derecha -->
        <Region HBox.hgrow="ALWAYS" />

        <Label fx:id="lblTotal" styleClass="pagination-info" text="Total registros: 0" />
    </HBox>

    <!-- ══ Tabla ══ -->
    <TableView fx:id="tablaBitacora" maxHeight="Infinity" maxWidth="Infinity" styleClass="data-table" VBox.vgrow="ALWAYS">

        <columns>
            <TableColumn fx:id="colUsuario" minWidth="120" text="Usuario" />
            <TableColumn fx:id="colTipo" minWidth="110" text="Tipo" />
            <TableColumn fx:id="colEntrada" minWidth="160" text="Fecha entrada" />
            <TableColumn fx:id="colSalida" minWidth="160" text="Fecha salida" />
            <TableColumn fx:id="colDuracion" minWidth="100" prefWidth="118.0" text="Duracion" />
        </columns>

        <placeholder>
            <Label styleClass="table-placeholder" text="No hay registros en este rango de fechas" />
        </placeholder>

    </TableView>

    <!-- ══ Paginación ══ -->
    <HBox alignment="CENTER_RIGHT" spacing="10">
        <Label fx:id="lblPaginacion" styleClass="pagination-info" text="Mostrando 1-10 de 0 registros" />
        <Button fx:id="btnAnterior" disable="true" onAction="#paginaAnterior" styleClass="btn-ghost-sm" text="Anterior" />
        <Button fx:id="btnSiguiente" onAction="#paginaSiguiente" styleClass="btn-ghost-sm" text="Siguiente" />
    </HBox>

</VBox>
